.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.claude/
*.log
reports_out/

# node dependencies for the slide generator
presentation/node_modules/

# generated documents and scratch (rebuild with report/build_report.py, presentation/build_deck.js)
report/work/
report/output/
report/template/
presentation/*.pptx

# raw data is downloaded by `python -m src.data_loader`; keep only the provenance record (source URL + SHA-256)
data/raw/*
!data/raw/provenance.json

# model binary is regenerated by `python -m src.train`; keep small evidence files
models/*.joblib
artifacts/*
!artifacts/README.md
!artifacts/metrics.json
!artifacts/model_comparison.csv
!artifacts/data_profile.json
!artifacts/screenshots/
